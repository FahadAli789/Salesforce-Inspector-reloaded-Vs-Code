{
  "name": "salesforce-inspector-reloaded-vscode",
  "publisher": "fahadali",
  "displayName": "Salesforce Inspector Reloaded",
  "description": "A port of the Salesforce Inspector Reloaded browser extension to VS Code.",
  "icon": "media/icon128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FahadAli789/Salesforce-Inspector-reloaded-Vs-Code"
  },
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "salesforce-inspector",
          "title": "Salesforce Inspector",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "salesforce-inspector": [
        {
          "type": "webview",
          "id": "salesforce-inspector.view",
          "name": "Inspector"
        }
      ]
    },
    "commands": [
      {
        "command": "salesforce-inspector.openInspector",
        "title": "Salesforce Inspector: Open"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^5.2.1"
  }
}
